<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Clinica.Master.cs" Inherits="App_Clinica.MasterPage" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="bg-light">
    <form id="form2" runat="server">

        <div class="container-fluid d-flex flex-column min-vh-100 p-0">

            <div class="d-flex justify-content-between align-items-center bg-white border-bottom p-3 shadow-sm">

                <div style="width: 16.666%;" class="ps-2">
                    <span class="fs-1 fw-bold text-primary">🩺 🏥 Sistema</span>
                </div>

                <div class="bg-light border p-2 rounded text-center flex-grow-1 mx-4">
                    <h2 class="m-0 fw-bold text-secondary text-uppercase fs-3" style="letter-spacing: 2px;">Clinica Medica
            </h2>
                </div>

                <div class="bg-light border p-2 rounded px-4">
                    <span class="fw-semibold text-muted">Bienvenido, Mr. X</span>
                </div>
            </div>

            <div class="row g-0 flex-grow-1">

                <div class="col-md-2 bg-white border-end d-flex flex-column p-4">
                    <div class="nav flex-column nav-pills gap-5 mt-3">
                        <a href="Default.aspx" class="nav-link active py-4 text-center border">INICIO</a>
                        <a href="" id="menuPacientes" runat="server" class="nav-link text-dark py-4 text-center border">PACIENTES</a>
                        <a href="" id="menuMedicos" runat="server" class="nav-link text-dark py-4 text-center border">MEDICOS</a>
                        <a href="" id="menuTurnos" runat="server" class="nav-link text-dark py-4 text-center border">TURNOS</a>
                        <a href="" id="menuUsuario" runat="server" class="nav-link text-dark py-4 text-center border">USUARIOS</a>

                        <asp:Button ID="btnSalir" runat="server" Text="Salir" CssClass="btn btn-outline-danger mt-3 py-4 w-100" />
                    </div>
                </div>

                <div class="col-md-10 d-flex flex-column p-4">
                    <div class="flex-grow-1">
                        <asp:ContentPlaceHolder ID="MainContent" runat="server">
                        </asp:ContentPlaceHolder>
                    </div>
                </div>

            </div>

            <footer class="bg-white border-top text-center py-3 shadow-sm mt-auto">
                <span class="text-muted">© 2026 - TPC Grupo 21B Clínica Médica - Todos los derechos reservados.</span>
            </footer>

        </div>

    </form>
</body>
<div>
    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
    </asp:ContentPlaceHolder>
</div>
</html>
