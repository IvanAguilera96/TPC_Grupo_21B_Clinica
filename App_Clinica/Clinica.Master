<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Clinica.Master.cs" Inherits="App_Clinica.MasterPage" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body class="bg-light">
    <form id="form2" runat="server">

        <div class="container-fluid d-flex flex-column min-vh-100 p-0">

            <div class="d-flex justify-content-between align-items-center bg-white border-bottom p-3 shadow-sm">

                <div style="width: 16.666%;" class="ps-2">
                    <span class="fs-1 fw-bold text-primary">🩺 🏥 Sistema</span>
                </div>

                <div class="bg-light border p-2 rounded text-center flex-grow-1 mx-4">
                    <h2 class="m-0 fw-bold text-secondary text-uppercase fs-3" style="letter-spacing: 2px;">Clinica Medica
            </h2>
                </div>

                <div class="bg-light border p-2 rounded px-4">
                    <span class="fw-semibold text-muted">Bienvenido, <asp:Label ID="lblUserNombre" runat="server" class="text-dark fw-bold"></asp:Label></span>
                </div>
            </div>

            <div class="row g-0 flex-grow-1">

                <div class="col-md-2 bg-white border-end d-flex flex-column p-4">
                    <div class="list-group gap-5 mt-3">

                        <a href="Default.aspx" class="list-group-item list-group-item-action active py-4 text-center border">INICIO</a>
                        <a href="PacientePag.aspx" id="menuPacientes" runat="server" class="list-group-item list-group-item-action py-4 text-center border">PACIENTES</a>
                        <a href="MedicoPag.aspx" id="menuMedicos" runat="server" class="list-group-item list-group-item-action py-4 text-center border">MEDICOS</a>
                        <a href="TurnosPag.aspx" id="menuTurnos" runat="server" class="list-group-item list-group-item-action py-4 text-center border">TURNOS</a>
                        <a href="EspecialidadPag.aspx" id="menuEspecialidad" runat="server" class="list-group-item list-group-item-action py-4 text-center border">ESPECIALIDADES</a>
                        <a href="Usuario.aspx" id="menuUsuario" runat="server" class="list-group-item list-group-item-action py-4 text-center border">USUARIOS</a>

                        <asp:Button ID="btnSalir" runat="server" Text="Salir" OnClick="btnSalir_Click" 
                        OnClientClick="return confirmarSalir(this);" CssClass="btn btn-outline-danger mt-3 py-4 w-100" />
                    </div>
                </div>

                <div class="col-md-10 d-flex flex-column p-4">
                    <div class="flex-grow-1">
                        <asp:ContentPlaceHolder ID="MainContent" runat="server">
                        </asp:ContentPlaceHolder>
                    </div>
                </div>

            </div>

            <footer class="bg-white border-top text-center py-3 shadow-sm mt-auto">
                <span class="text-muted">© 2026 - TPC Grupo 21B Clínica Médica - Todos los derechos reservados.</span>
            </footer>

        </div>
      
        <div class="modal fade" id="modalAlerta" tabindex="-1" aria-labelledby="modalAlertaLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-sm">
                <div class="modal-content border-0 shadow-sm" style="background-color: #FAF8F5; border-radius: 16px; overflow: hidden;">
            
                    <div class="modal-header border-0 d-flex align-items-center" style="background-color: #FCECEB; color: #C85A53; padding: 14px 18px;">
                        <h5 class="modal-title fw-bold fs-6 mb-0" id="modalAlertaLabel">
                            <i class="bi bi-exclamation-triangle-fill me-2" style="color: #C85A53;"></i>Atención
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="filter: opacity(0.5);"></button>
                    </div>
            
                    <div class="modal-body py-4 px-4">
                        <p id="lblMensajeModal" class="mb-0" 
                           style="font-size: 0.95rem; line-height: 1.5; color: #4A4642; font-family: 'Segoe UI', Tahoma, sans-serif; letter-spacing: -0.1px;">
                            Por favor, verifique los datos ingresados.
                        </p>
                    </div>

                    <div class="modal-footer border-0 pt-0 px-4 pb-3">
                        <button type="button" class="btn border-0 w-100 fw-bold rounded-3" data-bs-dismiss="modal" 
                                style="background-color: #FCECEB; color: #C85A53; padding: 9px; font-size: 0.9rem; transition: all 0.2s ease-in-out;"
                                onmouseover="this.style.backgroundColor='#FAD2D0'; this.style.color='#963B35';"
                                onmouseout="this.style.backgroundColor='#FCECEB'; this.style.color='#C85A53';">
                            Aceptar
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="modalConfirmarEliminar" tabindex="-1" aria-labelledby="modalConfirmarLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-sm">
                <div class="modal-content border-0 shadow-sm" style="background-color: #FAF8F5; border-radius: 16px; overflow: hidden;">
            
                    <div class="modal-header border-0 d-flex align-items-center" style="background-color: #FCECEB; color: #C85A53; padding: 14px 18px;">
                        <h5 class="modal-title fw-bold fs-6 mb-0" id="modalConfirmarLabel">
                            <i class="bi bi-exclamation-triangle-fill me-2" style="color: #C85A53;"></i>¿Eliminar registro?
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="filter: opacity(0.5);"></button>
                    </div>
            
                    <div class="modal-body py-4 px-4">
                        <p class="mb-0" style="font-size: 0.95rem; line-height: 1.5; color: #4A4642; font-family: 'Segoe UI', Tahoma, sans-serif; letter-spacing: -0.1px;">
                            Esta acción no se puede deshacer. ¿Está seguro de que desea continuar?
                        </p>
                    </div>
            
                    <div class="modal-footer border-0 pt-0 px-4 pb-3 d-flex gap-2">
                        <button type="button" class="btn border-0 flex-grow-1 fw-bold rounded-3" data-bs-dismiss="modal" 
                                style="background-color: #EAE6DF; color: #5A5550; padding: 9px; font-size: 0.9rem; transition: all 0.2s ease-in-out;"
                                onmouseover="this.style.backgroundColor='#DCD7CE'; this.style.color='#3A3733';"
                                onmouseout="this.style.backgroundColor='#EAE6DF'; this.style.color='#5A5550';">
                            Cancelar
                        </button>
                        <button type="button" id="btnMdlConfirmarBorrado" class="btn border-0 flex-grow-1 fw-bold rounded-3" 
                                style="background-color: #FCECEB; color: #C85A53; padding: 9px; font-size: 0.9rem; transition: all 0.2s ease-in-out;"
                                onmouseover="this.style.backgroundColor='#FAD2D0'; this.style.color='#963B35';"
                                onmouseout="this.style.backgroundColor='#FCECEB'; this.style.color='#C85A53';">
                            Eliminar
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <script type="text/javascript">
            var clickOriginal = null;

            function confirmarEliminar(boton) {
                // Si el botón ya fue confirmado por el modal, dejamos que viaje al servidor
                if (boton.dataset.confirmado === "true") {
                    boton.dataset.confirmado = "false"; // Reseteamos
                    return true;
                }

                // Guardamos la referencia del botón al que le hicieron click
                clickOriginal = boton;

                // Levantamos el modal de confirmación
                var modalEl = document.getElementById('modalConfirmarEliminar');
                var myModal = bootstrap.Modal.getOrCreateInstance(modalEl);
                myModal.show();

                return false;
            }

            // Cuando el usuario le da clic al botón "Eliminar" DENTRO del modal:
            document.addEventListener("DOMContentLoaded", function () {
                document.getElementById("btnMdlConfirmarBorrado").addEventListener("click", function () {
                    if (clickOriginal) {
                        clickOriginal.dataset.confirmado = "true";
                
                        // Cerramos el modal
                        var modalEl = document.getElementById('modalConfirmarEliminar');
                        bootstrap.Modal.getOrCreateInstance(modalEl).hide();
                
                        // Ejecutamos el evento del LinkButton
                        clickOriginal.click();
                    }
                });
            });

            function confirmarSalir(boton) {
                if (boton.dataset.confirmado === "true") {
                    boton.dataset.confirmado = "false";
                    return true;
                }

                clickOriginal = boton;

                // Cambiamos dinámicamente los textos del modal de eliminación para que sirva de Logout
                document.getElementById("modalConfirmarLabel").innerHTML = '<i class="bi bi-door-open-fill me-2" style="color: #C85A53;"></i>¿Cerrar Sesión?';
                document.querySelector("#modalConfirmarEliminar .modal-body p").innerText = "Está a punto de salir del sistema. ¿Desea continuar?";

                // Cambiamos el texto del botón verde/rojo de confirmación
                var btnConfirmar = document.getElementById("btnMdlConfirmarBorrado");
                btnConfirmar.innerText = "Salir";
                btnConfirmar.className = "btn btn-danger flex-grow-1 fw-bold rounded-3"; // Un rojo sutil

                var modalEl = document.getElementById('modalConfirmarEliminar');
                var myModal = bootstrap.Modal.getOrCreateInstance(modalEl);
                myModal.show();

                return false;
            }
        </script>

    </form>
</body>
</html>
